# Пароль для входу в панель. Якщо не задати — панель відкрита без пароля (ок лише для локального запуску).
ADMIN_PASSWORD=

# Шлях до JSON-ключа сервісного акаунта (за замовчуванням ./credentials/service-account.json)
# GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./credentials/service-account.json

# Альтернатива для хостингу (Vercel тощо): весь вміст JSON-ключа одним рядком або в base64
# GOOGLE_SERVICE_ACCOUNT_JSON=

# Папка для локальних даних панелі (список застосунків, групи тестувальників)
# DATA_DIR=data
